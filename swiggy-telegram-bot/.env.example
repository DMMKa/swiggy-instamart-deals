# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================

# Telegram Bot Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID or Channel/Group Chat ID (Get this from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_chat_id_here

# Minimum Discount % to trigger alert (e.g. 70 means alerts for >= 70% OFF)
MIN_DISCOUNT_PERCENT=70

# ==============================================================================
# Swiggy Store Configuration
# (Go to swiggy.com/instamart -> click any Category -> check URL for store IDs)
# ==============================================================================

# Your local Instamart store pod ID (storeId and primaryStoreId are identical)
SWIGGY_STORE_ID=your_store_id_here
SWIGGY_PRIMARY_STORE_ID=your_store_id_here

# Secondary store ID (add if available in your category URL; otherwise leave empty)
SWIGGY_SECONDARY_STORE_ID=

# ==============================================================================
# Optional Per-Worker Discount Thresholds (Defaults shown)
# ==============================================================================
# FRESH_MIN_DISCOUNT=60
# GROCERY_MIN_DISCOUNT=60
# TREATS_MIN_DISCOUNT=70
# MUNCHIES_MIN_DISCOUNT=70
# BEVERAGES_MIN_DISCOUNT=70
# PERSONAL_MIN_DISCOUNT=70
# LIFESTYLE_MIN_DISCOUNT=85
